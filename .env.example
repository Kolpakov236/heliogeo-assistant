# ===== InfluxDB =====
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-token-here
INFLUX_ORG=heliogeo
INFLUX_BUCKET=solar

# ===== DAV (изображения) =====
DAV_BASE_URL=https://dav.example.com
DAV_USER=your-user
DAV_PASSWORD=your-password

# ===== LLM =====
LLM_PROVIDER=alice
LLM_API_KEY=your-api-key
LLM_MODEL=yandexgpt
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# ===== Database (PostgreSQL) =====
# Локальная БД из docker compose (make up). Те же POSTGRES_USER/PASSWORD/DB/PORT
# читает compose; приложение собирает из них DSN (POSTGRES_HOST — только для приложения).
POSTGRES_USER=heliogeo
POSTGRES_PASSWORD=heliogeo
POSTGRES_DB=heliogeo
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Полный DSN приоритетнее POSTGRES_* (например, для облачной БД):
# DATABASE_URL=postgresql+psycopg://user:pass@host:6432/heliogeo?sslmode=verify-full

# ===== Хранилище объектов =====
# local — каталог OBJECT_STORE_DIR (бакеты — подкаталоги), s3 — Yandex Object Storage.
# Для s3 ключи доступа задаются стандартными переменными AWS_ACCESS_KEY_ID и AWS_SECRET_ACCESS_KEY
# (в облаке — ключ сервисного аккаунта из Lockbox); в этом файле их держать не нужно.
OBJECT_STORE=local
# OBJECT_STORE_DIR=var/objects
BUCKET_PREFIX=heliogeo
# S3_ENDPOINT_URL=https://storage.yandexcloud.net
# S3_REGION=ru-central1

# ===== Контракты (доменные YAML под версионированием) =====
# По умолчанию contracts/ в корне репозитория; задайте, если каталог лежит в другом месте
# CONTRACTS_DIR=contracts

# ===== App =====
LOG_LEVEL=INFO
TZ=UTC

# ===== SWX API =====
SWX_BASE_URL=https://503.ifz.ru/swx
