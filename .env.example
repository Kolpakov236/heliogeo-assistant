# ===== InfluxDB =====
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-token-here
INFLUX_ORG=heliogeo
INFLUX_BUCKET=solar

# ===== DAV (изображения) =====
DAV_BASE_URL=https://dav.example.com
DAV_USER=your-user
DAV_PASSWORD=your-password

# ===== LLM =====
LLM_PROVIDER=alice
LLM_API_KEY=your-api-key
LLM_MODEL=yandexgpt
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://user:pass@localhost:5432/heliogeo

# ===== App =====
LOG_LEVEL=INFO
TZ=UTC

# ===== SWX API =====
SWX_BASE_URL=https://503.ifz.ru/swx
